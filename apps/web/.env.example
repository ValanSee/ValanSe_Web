NEXT_PUBLIC_KAKAO_CLIENT_ID=your_kakao_client_id
NEXT_PUBLIC_BASE_URL=https://valanserver.store/dev-server/
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao/redirect
NEXT_PUBLIC_KAKAO_URL=https://kauth.kakao.com/oauth/authorize

# 행사용 비공개 투표 방 (/event/*). 관리자 방 생성 키 — 아무 긴 랜덤 문자열
EVENT_ADMIN_KEY=change-me
# 방 상태 저장소. 비우면 로컬 메모리(next dev 전용).
# Vercel 의 Upstash for Redis 연동(valanse-event-redis)이 KV_REST_API_URL · KV_REST_API_TOKEN 을 자동 주입한다.
# 로컬에서 실제 Redis 를 쓰려면 Vercel 대시보드 > Storage > valanse-event-redis 의 .env.local 스니펫을 복사.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Cron 인증 (/api/indexnow). Vercel 이 Authorization: Bearer {값} 으로 호출
CRON_SECRET=change-me
